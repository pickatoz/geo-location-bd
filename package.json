{
  "name": "geo-location-bd",
  "version": "1.0.0",
  "description": "Bangladesh geo-location data package with division, district and thana lookup",
  "homepage": "https://github.com/pickatoz/geo-location-bd#readme",
  "bugs": {
    "url": "https://github.com/pickatoz/geo-location-bd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pickatoz/geo-location-bd.git"
  },
  "license": "MIT",
  "author": "Pickatoz",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "main": "dist/index.cjs",
